{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run MarketingHub in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start MarketingHub (localhost:3000)"
    },
    {
      "name": "Run MarketingHub in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start MarketingHub (localhost:3000)"
    }
  ]
}
